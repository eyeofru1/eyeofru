# Project Environment Configuration
# Global credentials default to ~/.gemini/.env
# Do not commit secrets here.

# Google Gemini API for prospecting, audit generation, and AI content
GEMINI_API_KEY=

# Google Maps / Places API for GBP photos, reviews, and geo-telemetry
GOOGLE_PLACES_API_KEY=

# Web3Forms Access Key for static HTML contact form submissions
WEB3FORMS_ACCESS_KEY=

# Cloudflare API Token for Pages deployments and DNS management
CLOUDFLARE_API_TOKEN=
